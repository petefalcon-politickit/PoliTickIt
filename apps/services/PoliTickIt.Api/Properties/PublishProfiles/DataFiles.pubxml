<?xml version="1.0" encoding="utf-8"?>
<!--
  DataFiles Publish Profile
  ═══════════════════════════════════════════════════════════════
  Purpose : Deploy the complete API to a local FileSystem target.
            Use this profile when you want to push a new build +
            updated snap data files together.

  For DATA-ONLY updates (no code change):
    1. Add/edit files in Data/snaps/
    2. Run: dotnet msbuild PoliTickIt.Api.csproj /t:DeployDataFiles /p:DeployTarget=<path>
    3. Call: POST <host>/admin/reload

  To publish the full app:
    dotnet publish PoliTickIt.Api.csproj /p:PublishProfile=DataFiles
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish />
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <!-- Update publishUrl to your deployment target path -->
    <publishUrl>bin\DataFiles\publish</publishUrl>
    <DeleteExistingFiles>false</DeleteExistingFiles>
  </PropertyGroup>
</Project>
