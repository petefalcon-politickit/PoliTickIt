<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio Publish Profile — Politickit-AWA (Azure Web App)
  Target : https://Politickit-AWA.azurewebsites.net
  RG     : Politickit-RG  |  Sub: b82d4f5c-a655-4987-9314-41fa1799de88
  To publish: right-click PoliTickIt.Api → Publish → select this profile.
  Credentials are stored locally in Politickit-AWA.pubxml.user (gitignored).
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://Politickit-AWA.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>True</LaunchSiteAfterPublish>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <MSDeployServiceURL>Politickit-AWA.scm.azurewebsites.net:443</MSDeployServiceURL>
    <DeployIisAppPath>Politickit-AWA</DeployIisAppPath>
    <SkipExtraFilesOnServer>True</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>True</EnableMSDeployBackup>
    <EnableMsDeployAppOffline>True</EnableMsDeployAppOffline>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <_TargetId>Cafe</_TargetId>
    <ResourceId>/subscriptions/b82d4f5c-a655-4987-9314-41fa1799de88/resourceGroups/Politickit-RG/providers/Microsoft.Web/sites/Politickit-AWA</ResourceId>
    <UserName>petefalcon1028@gmail.com</UserName>
  </PropertyGroup>
</Project>