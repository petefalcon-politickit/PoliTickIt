    {
      "id": "floor-statement",
      "type": "Narrative.Congressional.Statement",
      "data": {
        "quote": "I represent Silicon Valley, where automation is eliminating the jobs this bill assumes exist. Work requirements make sense in theory but fail in practice. The data from every state that has tried this is unambiguous: coverage drops, employment doesn't rise, and administrative costs soar. We cannot let ideology override evidence.",
        "speaker": "Ro Khanna",
        "date": "2026-05-22",
        "context": "House floor statement explaining vote against H.R.5500",
        "fullTranscriptId": null
      }
    },
