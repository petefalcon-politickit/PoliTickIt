      "data": {
        "billName": "Medicaid Work Requirements and Integrity Act",
        "vote": "Nay"
      }
    },
    {
      "id": "bill-context",
      "type": "Narrative.Insight.Summary",
      "data": {
        "title": "About H.R.5500",
        "text": "H.R.5500 passed 221-214 requiring able-bodied Medicaid recipients aged 19-55 to complete 80 hours of work, education, or community service per month. Proponents argue it promotes self-sufficiency; the CBO estimates 4.5 million people would lose coverage in three years. No Democratic votes supported the bill.",
        "isExpandable": true,
        "sourceLink": "https://khanna.house.gov/media/press-releases"
      }
