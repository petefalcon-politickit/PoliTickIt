<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoliTickIt.Domain\PoliTickIt.Domain.csproj" />
    <ProjectReference Include="..\PoliTickIt.Ingestion\PoliTickIt.Ingestion.csproj" />
    <ProjectReference Include="..\PoliTickIt.Infrastructure\PoliTickIt.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Snap data files — included in dotnet publish output.
    Drop new *.json files here and call POST /admin/reload
    to hot-update content without redeploying code.
  -->
  <ItemGroup>
    <Content Update="Data\snaps\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    DeployDataFiles target — copy ONLY snap JSON files to a target folder.
    Usage: dotnet msbuild PoliTickIt.Api.csproj /t:DeployDataFiles /p:DeployTarget=C:\path\to\app
    After copy, call: POST https://<host>/admin/reload
  -->
  <Target Name="DeployDataFiles">
    <Error Condition="'$(DeployTarget)' == ''"
           Text="Provide /p:DeployTarget=&lt;absolute-path-to-deployed-app-root&gt;" />
    <ItemGroup>
      <_DataSnapFiles Include="$(MSBuildProjectDirectory)\Data\snaps\**\*.json" />
    </ItemGroup>
    <MakeDir Directories="$(DeployTarget)\Data\snaps" />
    <Copy SourceFiles="@(_DataSnapFiles)"
          DestinationFiles="@(_DataSnapFiles->'$(DeployTarget)\Data\snaps\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Text="[DeployDataFiles] Deployed $([System.Int32]::Parse('0').ToString()) → $(DeployTarget)\Data\snaps\" Importance="high" />
  </Target>

</Project>
